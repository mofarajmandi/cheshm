# Copy to .env and fill in real values. .env is gitignored — never commit it.

CAMERA_IP=
CAMERA_RTSP_USER=
CAMERA_RTSP_PASS=
CAMERA_ONVIF_PORT=2020

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frigate's own admin web UI login (NOT the camera's RTSP/ONVIF account) --
# lets frigate-notify poll Frigate's API for alerts.
FRIGATE_ADMIN_USER=admin
FRIGATE_ADMIN_PASSWORD=
